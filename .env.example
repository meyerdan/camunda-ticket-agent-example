# Camunda / Zeebe connection
ZEEBE_REST_ADDRESS=http://localhost:8080
ZEEBE_GRPC_ADDRESS=grpc://localhost:26500
CAMUNDA_AUTH_STRATEGY=NONE

# Ticketmaster Discovery API
# Get a key at https://developer.ticketmaster.com/
TICKETMASTER_API_KEY=

# Spotify Web API (OAuth)
# Create an app at https://developer.spotify.com/dashboard
# Refresh token: use the Authorization Code flow with scopes user-top-read, user-library-read
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# OpenAI — set globally (e.g. in ~/.zprofile) so the C8 Run connector runtime inherits it.
# It is exposed to the BPMN as {{secrets.OPENAI_API_KEY}}.
# OPENAI_API_KEY=
