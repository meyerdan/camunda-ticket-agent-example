        <bpmndi:BPMNLabel>
          <dc:Bounds x="1548" y="295" width="25" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Error_di" bpmnElement="End_Error">
        <dc:Bounds x="1542" y="492" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1528" y="535" width="57" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BoundaryEvent_AgentError_di" bpmnElement="BoundaryEvent_AgentError">
        <dc:Bounds x="1122" y="432" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1112" y="475" width="57" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_TimerToFetch_di" bpmnElement="Flow_TimerToFetch">
        <di:waypoint x="188" y="240" />
        <di:waypoint x="214" y="240" />
        <di:waypoint x="214" y="270" />
        <di:waypoint x="240" y="270" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ManualToFetch_di" bpmnElement="Flow_ManualToFetch">
        <di:waypoint x="188" y="310" />
        <di:waypoint x="214" y="310" />
        <di:waypoint x="214" y="270" />
        <di:waypoint x="240" y="270" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToFetchSpotify_di" bpmnElement="Flow_ToFetchSpotify">
        <di:waypoint x="340" y="270" />
        <di:waypoint x="390" y="270" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToMatchArtists_di" bpmnElement="Flow_ToMatchArtists">
        <di:waypoint x="490" y="270" />
        <di:waypoint x="540" y="270" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToGatewayMatches_di" bpmnElement="Flow_ToGatewayMatches">
        <di:waypoint x="640" y="270" />
        <di:waypoint x="695" y="270" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_NoMatches_di" bpmnElement="Flow_NoMatches">
        <di:waypoint x="720" y="295" />
        <di:waypoint x="720" y="392" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToAgent_di" bpmnElement="Flow_ToAgent">
        <di:waypoint x="745" y="270" />
        <di:waypoint x="800" y="270" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_AgentDone_di" bpmnElement="Flow_AgentDone">
        <di:waypoint x="1480" y="270" />
        <di:waypoint x="1542" y="270" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToErrorEnd_di" bpmnElement="Flow_ToErrorEnd">
        <di:waypoint x="1140" y="468" />
        <di:waypoint x="1140" y="510" />
        <di:waypoint x="1542" y="510" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
