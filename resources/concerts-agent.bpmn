<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.44.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:message id="Message_WebhookReply" name="61fcf4d0-f116-4736-8955-a3fb4054242e">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=replyCorrelationKey" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:process id="concerts-agent" name="Concerts Agent" isExecutable="true">
    <bpmn:startEvent id="StartEvent_Timer" name="Weekly check">
      <bpmn:outgoing>Flow_TimerToFetch</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">="R/P7D"</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:startEvent id="StartEvent_Manual" name="Manual start">
      <bpmn:outgoing>Flow_ManualToFetch</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_FetchConcerts" name="Fetch concerts">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="fetch-concerts" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_TimerToFetch</bpmn:incoming>
      <bpmn:incoming>Flow_ManualToFetch</bpmn:incoming>
      <bpmn:outgoing>Flow_ToFetchSpotify</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_FetchSpotify" name="Fetch Spotify library">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="fetch-spotify" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToFetchSpotify</bpmn:incoming>
      <bpmn:outgoing>Flow_ToMatchArtists</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_MatchArtists" name="Match artists">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="match-artists" retries="1" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToMatchArtists</bpmn:incoming>
      <bpmn:outgoing>Flow_ToGatewayMatches</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Matches" name="Matches found?" default="Flow_ToAgent">
      <bpmn:incoming>Flow_ToGatewayMatches</bpmn:incoming>
      <bpmn:outgoing>Flow_NoMatches</bpmn:outgoing>
      <bpmn:outgoing>Flow_ToAgent</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_NoMatches" name="No matches">
      <bpmn:incoming>Flow_NoMatches</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:adHocSubProcess id="AgentTools" name="Concert Assistant" zeebe:modelerTemplate="io.camunda.connectors.agenticai.aiagent.jobworker.v1" zeebe:modelerTemplateVersion="6" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda.agenticai:aiagent-job-worker:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="openai" target="provider.type" />
          <zeebe:input source="{{secrets.OPENAI_API_KEY}}" target="provider.openai.authentication.apiKey" />
          <zeebe:input source="gpt-4o" target="provider.openai.model.model" />
          <zeebe:input source="=4096" target="provider.openai.model.parameters.maxCompletionTokens" />
          <zeebe:input source="=0.5" target="provider.openai.model.parameters.temperature" />
          <zeebe:input source="=&#34;You are a friendly concert assistant for a couple in Boston. You have a list of upcoming concerts that match their Spotify listening history.&#10;&#10;CRITICAL RULES:&#10;- You can ONLY communicate with the user by calling the &#39;Send message and wait for reply&#39; tool. You have NO other way to reach them.&#10;- NEVER end the conversation without sending a message first. If the user asks a question, you MUST call the send tool with your answer.&#10;- After each user reply, decide what to do next: answer their question, use a tool to look something up, or ask a follow-up.&#10;- Only stop (make no more tool calls) AFTER you have sent a final goodbye message AND the user has confirmed they are done.&#10;&#10;Your job:&#10;1. Send an initial message notifying them about the matching concerts&#10;2. Answer questions about concerts using the available tools (get details, check prices)&#10;3. Book tickets when requested&#10;4. Keep the conversation going until the user says goodbye or is done&#10;&#10;Available tools:&#10;- &#39;Send message and wait for reply&#39;: Send a message and wait for the user response. ALWAYS use this to communicate.&#10;- &#39;Get concert details&#39;: Look up detailed info about a specific concert.&#10;- &#39;Check ticket price&#39;: Check pricing and availability for a concert.&#10;- &#39;Book tickets&#39;: Book tickets for a concert.&#10;&#10;Keep messages concise and friendly — this is a chat conversation.&#10;Start by sending a notification about the matching concerts.&#34;" target="data.systemPrompt.prompt" />
          <zeebe:input source="=&#34;Matching concerts found: &#34; + string(matchedConcerts)" target="data.userPrompt.prompt" />
          <zeebe:input target="agentContext" />
          <zeebe:input source="in-process" target="data.memory.storage.type" />
          <zeebe:input source="=20" target="data.memory.contextWindowSize" />
          <zeebe:input source="=30" target="data.limits.maxModelCalls" />
          <zeebe:input source="WAIT_FOR_TOOL_CALL_RESULTS" target="data.events.behavior" />
          <zeebe:input source="text" target="data.response.format.type" />
          <zeebe:input source="=false" target="data.response.format.parseJson" />
          <zeebe:input source="=false" target="data.response.includeAssistantMessage" />
          <zeebe:input source="=false" target="data.response.includeAgentContext" />
          <zeebe:output source="=agent" target="agent" />
        </zeebe:ioMapping>
        <zeebe:adHoc outputCollection="toolCallResults" outputElement="={&#10;  id: toolCall._meta.id,&#10;  name: toolCall._meta.name,&#10;  content: toolCallResult&#10;}" />
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="6" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.agenticai.aiagent.jobworker.v1" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToAgent</bpmn:incoming>
      <bpmn:outgoing>Flow_AgentDone</bpmn:outgoing>
      <bpmn:serviceTask id="Tool_SendMessage" name="Send message and wait for reply">
        <bpmn:documentation>Send a WhatsApp message to the user and wait for their reply. Returns the user's reply text. Use this tool every time you want to communicate with the user.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="send-whatsapp-reply" retries="1" />
          <zeebe:ioMapping>
            <zeebe:input source="=fromAi(toolCall.messageText, &#34;The message text to send to the user via WhatsApp&#34;, &#34;string&#34;)" target="messageText" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:outgoing>Flow_SendToWait</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sequenceFlow id="Flow_SendToWait" sourceRef="Tool_SendMessage" targetRef="Tool_WaitReply" />
      <bpmn:serviceTask id="Tool_GetDetails" name="Get concert details">
        <bpmn:documentation>Look up detailed information about a specific concert from the matched list, including venue, date, performers, and description.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="get-concert-details" retries="1" />
          <zeebe:ioMapping>
            <zeebe:input source="=fromAi(toolCall.concertName, &#34;Name or partial name of the concert to look up&#34;, &#34;string&#34;)" target="concertName" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="Tool_CheckPrice" name="Check ticket price">
        <bpmn:documentation>Check ticket pricing and availability for a specific concert. Returns price ranges and available ticket types.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="check-ticket-price" retries="1" />
          <zeebe:ioMapping>
            <zeebe:input source="=fromAi(toolCall.concertName, &#34;Name or partial name of the concert to check pricing for&#34;, &#34;string&#34;)" target="concertName" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="Tool_BookTickets" name="Book tickets">
        <bpmn:documentation>Book tickets for a concert. Use this when the user confirms they want to purchase tickets.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="book-tickets" retries="1" />
          <zeebe:ioMapping>
            <zeebe:input source="=fromAi(toolCall.concertName, &#34;Name of the concert to book tickets for&#34;, &#34;string&#34;)" target="concertName" />
            <zeebe:input source="=fromAi(toolCall.quantity, &#34;Number of tickets to book&#34;, &#34;number&#34;)" target="quantity" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
      </bpmn:serviceTask>
      <bpmn:intermediateCatchEvent id="Tool_WaitReply" name="Wait for reply" zeebe:modelerTemplate="io.camunda.connectors.webhook.WebhookConnectorIntermediate.v1" zeebe:modelerTemplateVersion="13" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
        <bpmn:extensionElements>
          <zeebe:properties>
            <zeebe:property name="inbound.type" value="io.camunda:webhook:1" />
            <zeebe:property name="inbound.method" value="any" />
            <zeebe:property name="inbound.context" value="whatsapp-reply" />
            <zeebe:property name="inbound.shouldValidateHmac" value="disabled" />
            <zeebe:property name="inbound.auth.type" value="NONE" />
            <zeebe:property name="consumeUnmatchedEvents" value="true" />
            <zeebe:property name="correlationKeyExpression" value="=request.body.correlationKey" />
            <zeebe:property name="deduplicationModeManualFlag" value="false" />
            <zeebe:property name="deduplicationMode" value="AUTO" />
            <zeebe:property name="resultVariable" value="" />
            <zeebe:property name="resultExpression" value="={toolCallResult: request.body.text}" />
          </zeebe:properties>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_SendToWait</bpmn:incoming>
        <bpmn:messageEventDefinition id="MessageEventDefinition_1gb5js4" messageRef="Message_0smq3b9" />
      </bpmn:intermediateCatchEvent>
    </bpmn:adHocSubProcess>
    <bpmn:boundaryEvent id="BoundaryEvent_AgentError" name="Agent error" attachedToRef="AgentTools">
      <bpmn:outgoing>Flow_ToErrorEnd</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_AgentError" />
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="End_Done" name="Done">
      <bpmn:incoming>Flow_AgentDone</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Error" name="Agent error">
      <bpmn:incoming>Flow_ToErrorEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_TimerToFetch" sourceRef="StartEvent_Timer" targetRef="Task_FetchConcerts" />
    <bpmn:sequenceFlow id="Flow_ManualToFetch" sourceRef="StartEvent_Manual" targetRef="Task_FetchConcerts" />
    <bpmn:sequenceFlow id="Flow_ToFetchSpotify" sourceRef="Task_FetchConcerts" targetRef="Task_FetchSpotify" />
    <bpmn:sequenceFlow id="Flow_ToMatchArtists" sourceRef="Task_FetchSpotify" targetRef="Task_MatchArtists" />
    <bpmn:sequenceFlow id="Flow_ToGatewayMatches" sourceRef="Task_MatchArtists" targetRef="Gateway_Matches" />
    <bpmn:sequenceFlow id="Flow_NoMatches" sourceRef="Gateway_Matches" targetRef="End_NoMatches">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=count(matchedConcerts) = 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ToAgent" sourceRef="Gateway_Matches" targetRef="AgentTools" />
    <bpmn:sequenceFlow id="Flow_AgentDone" sourceRef="AgentTools" targetRef="End_Done" />
    <bpmn:sequenceFlow id="Flow_ToErrorEnd" sourceRef="BoundaryEvent_AgentError" targetRef="End_Error" />
  </bpmn:process>
  <bpmn:message id="Message_0smq3b9" name="f8851df2-49ee-444b-af76-c1c46ec29441" zeebe:modelerTemplate="io.camunda.connectors.webhook.WebhookConnectorIntermediate.v1">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=replyCorrelationKey" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="concerts-agent">
      <bpmndi:BPMNShape id="StartEvent_Timer_di" bpmnElement="StartEvent_Timer">
        <dc:Bounds x="152" y="222" width="36" height="36" />
        <bpmndi:BPMNLabel>
